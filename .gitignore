# API keys for the agent LLM providers (see sscg/.env.example)
.env
.env.*
!.env.example

# Python bytecode (files already tracked stay tracked until removed with git rm --cached)
__pycache__/

# saved state of agent runs paused for approval (local SQLite checkpoints)
.sscg-state/
*.pyc
.venv/
.sscg-venv-*
.pytest_cache/
node_modules/
sscg/web/dist/

# run state created by SSCG: fetched GitHub files, context store, live OKF bundle
sscg/.work/
sscg/.context/
sscg/.okf/

# scan results: only the demo snapshot is kept in git
sscg/out/*
!sscg/out/sscg-demo-target/
