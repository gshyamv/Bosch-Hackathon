# API keys for the agent LLM providers (see sscg/.env.example)
.env
.env.*
!.env.example

# Python bytecode (files already tracked stay tracked until removed with git rm --cached)
__pycache__/

# saved state of agent runs paused for approval (local SQLite checkpoints)
.sscg-state/
*.pyc
.venv/
.sscg-venv-*
.pytest_cache/
node_modules/
sscg/web/dist/

# run state created by SSCG: fetched GitHub files, context store, live OKF bundle
sscg/.work/
sscg/.context/
sscg/.okf/


# local caches, run outputs and editor/build files (rebuilt locally)
sscg/.cache/
sscg/out/
*.tsbuildinfo
.vscode/
.idea/
*.log

# sample apps are cloned locally (see README); only the demo app is a submodule
targets/*
!targets/sscg-demo-app
