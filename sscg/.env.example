# Copy to sscg/.env (git-ignored) and put ONE real API key below. With no key the agents use the
# labelled rules-only fallback, so the whole pipeline still runs. Keys are never written to outputs or prompts.
# Details: docs/agentic.md §4.

# auto = first provider with a key; or claude | gemini | groq | deepseek | grok | none
SSCG_LLM_PROVIDER=auto

# Anthropic Claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash      (comma-separated = fallbacks)

# Groq (GroqCloud)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_TPM=8000
# GROQ_RPM=30

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat,deepseek-reasoner

# xAI Grok
XAI_API_KEY=
# GROK_MODEL=grok-4

# Limits (optional)
# SSCG_LLM_MAX_TRIAGE=15        findings sent to the Triage agent per scan
# SSCG_LLM_MAX_ROUNDS=2         triage <-> evidence-request rounds per finding
# SSCG_LLM_MAX_TOKENS=1500
# SSCG_LLM_CONCURRENCY=4
# SSCG_LLM_RPM=
# SSCG_LLM_TPM=
# SSCG_LLM_TEMPERATURE=

# Remediation (optional)
# SSCG_REMEDIATE_LEVELS=P0,P1   priorities that get a proposal
# SSCG_MAX_PROPOSALS=20
# SSCG_VALIDATE_TIMEOUT=600     seconds per install / build / test step
